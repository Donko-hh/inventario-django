# ==========================================
# Configuración del Entorno - Ejemplo
# ==========================================

# Django Core
SECRET_KEY=tu_django_secret_key_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de Datos (Supabase / PostgreSQL)
# Formato: postgresql://postgres.[project-ref]:[DB_PASSWORD]@[host]:[port]/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.tu_project_ref:tu_password_db@aws-0-tu-region.pooler.supabase.com:5432/postgres?sslmode=require
USE_SQLITE=False

# Parámetros individuales de respaldo
DB_NAME=postgres
DB_USER=postgres.tu_project_ref
DB_PASSWORD=tu_password_db
DB_HOST=aws-0-tu-region.pooler.supabase.com
DB_PORT=5432

# Credenciales de API de Supabase (opcionales para backend Django)
SUPABASE_URL=https://tu_project_ref.supabase.co
SUPABASE_PROJECT_REF=tu_project_ref
SUPABASE_PUBLISHABLE_KEY=tu_publishable_key_aqui
SUPABASE_SECRET_KEY=tu_secret_key_aqui
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# SimpleJWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL_ORIGINS=True
